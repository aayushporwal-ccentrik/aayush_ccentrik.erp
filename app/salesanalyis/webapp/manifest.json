{
  "_version": "1.84.0",
  "sap.app": {
    "id": "com.aayush.sa.salesanalyis",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.2"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:alp",
      "version": "1.24.0",
      "toolsId": "5fb14d47-38d1-49d7-988c-0637e55616b2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/CatalogService/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Sales_Order-analyze": {
          "semanticObject": "Sales_Order",
          "action": "analyze",
          "title": "Analyze Sales Performance",
          "subTitle": "Sales Analytics ALP",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.aayush.sa.salesanalyis.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SalesAnalyticsList",
          "target": "SalesAnalyticsList"
        },
        {
          "pattern": "SalesAnalytics({key}):?query:",
          "name": "SalesAnalyticsObjectPage",
          "target": "SalesAnalyticsObjectPage"
        },
        {
          "pattern": "SalesAnalytics({key})/items({key2}):?query:",
          "name": "SalesOrderItemsObjectPage",
          "target": "SalesOrderItemsObjectPage"
        }
      ],
      "targets": {
        "SalesAnalyticsList": {
          "type": "Component",
          "id": "SalesAnalyticsList",
          "name": "sap.fe.templates.AnalyticalListPage",
          "options": {
            "settings": {
              "contextPath": "/SalesAnalytics",
              "variantManagement": "Page",
              "navigation": {
                "SalesAnalytics": {
                  "detail": {
                    "route": "SalesAnalyticsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "AnalyticalTable",
                    "selectionMode": "Multi"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "primary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant"
                      }
                    ],
                    "secondary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.LineItem"
                      }
                    ],
                    "defaultPath": "both"
                  }
                ]
              }
            }
          }
        },
        "SalesAnalyticsObjectPage": {
          "type": "Component",
          "id": "SalesAnalyticsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/SalesAnalytics",
              "navigation": {
                "items": {
                  "detail": {
                    "route": "SalesOrderItemsObjectPage"
                  }
                }
              }
            }
          }
        },
        "SalesOrderItemsObjectPage": {
          "type": "Component",
          "id": "SalesOrderItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/SalesAnalytics/items"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "erp"
  }
}