{
  "name": "erp",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy erp --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-manageproducts2": "cds watch --open com.aayush.erp.products.manageproducts2/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-analysestock": "cds watch --open com.cements.erp.stock.analysestock/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manageproducts": "cds watch --open com.cements.erp.products.manageproducts/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manageso": "cds watch --open com.aayush.so.manageso/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-salesanalyis": "cds watch --open com.aayush.sa.salesanalyis/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-production-ovp": "cds watch --open com.aayush.po.productionovp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/manageproducts2",
    "app/analysestock",
    "app/project1",
    "app/manageproducts",
    "app/manageso",
    "app/salesanalyis",
    "app/salesanalyis",
    "app/production-ovp"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[development]": {
        "db": {
          "kind": "sqlite"
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "aayush": {
              "roles": [
                "Viewer",
                "Editor"
              ]
            }
          }
        }
      }
    }
  }
}
